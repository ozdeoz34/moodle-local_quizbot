{{!
    @template local_quizbot/contact

    The line at the foot of every page of the wizard: a problem or an idea goes straight to Quizbot by e-mail. The
    e-mail opens in the teacher's own mail program, already holding what Quizbot needs to find the run - never any
    student data.

    Example context (json):
    {
        "mailto": "mailto:info@quizbot.ai?subject=Quizbot%20for%20Moodle"
    }
}}
<p class="local-quizbot-contact small text-center mt-4 mb-0">
    {{#str}}contact_text, local_quizbot{{/str}} <a href="{{mailto}}">{{#str}}contact_link, local_quizbot{{/str}}</a>
</p>
