{{!
    @template local_quizbot/steps

    The three steps of the wizard, with the current one marked: numbered squares in the Quizbot style (styles.css),
    a tick on the steps done.

    Example context (json):
    {
        "steps": [
            {"number": 1, "label": "Sources", "done": true, "current": false},
            {"number": 2, "label": "Questions", "done": false, "current": true},
            {"number": 3, "label": "Review and save", "done": false, "current": false}
        ]
    }
}}
<ol class="local-quizbot-steps list-unstyled d-flex flex-wrap align-items-center mb-4" aria-label="{{#str}}generate, local_quizbot{{/str}}">
    {{#steps}}
    <li class="local-quizbot-step d-flex align-items-center {{#current}}is-current{{/current}}{{#done}}is-done{{/done}}" {{#current}}aria-current="step"{{/current}}>
        <span class="local-quizbot-stepnum">{{#done}}&#10003;{{/done}}{{^done}}0{{number}}{{/done}}</span>
        <span class="local-quizbot-steplabel">{{label}}</span>
    </li>
    {{/steps}}
</ol>
